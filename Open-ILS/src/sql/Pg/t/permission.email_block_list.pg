BEGIN;

SELECT plan(5);

SELECT has_column('permission', 'email_block_list',
    'address', 'address column created');

SELECT has_column('permission', 'email_block_list',
    'type', 'type column created');

PREPARE insert_email_without_at_symbol AS INSERT INTO permission.email_block_list (address, type) VALUES ('incorrect-format', 'email');
SELECT throws_ilike('insert_email_without_at_symbol',
    '%must_be_a_valid_email%',
    'email should include at symbol');

PREPARE blocked_domain AS SELECT permission.blocks_for_email_address('abc123@paristorage.net');
SELECT isnt_empty('blocked_domain', 'it can block an email address based on its domain');

PREPARE subdomain_of_blocked_domain AS SELECT permission.blocks_for_email_address('abc123@apotex.paristorage.net');
SELECT isnt_empty('subdomain_of_blocked_domain', 'it can block an email address at a subdomain of a blocked domain');

ROLLBACK;
